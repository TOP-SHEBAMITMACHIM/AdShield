    <string name="settings_about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_body">AdShield filters DNS on-device through a local VPN, so no server ever sees your traffic. Pair it with the built-in browser for request-level and cosmetic ad blocking, and enable the hosts mode on rooted devices for system-wide blocking that no app can bypass.</string>

