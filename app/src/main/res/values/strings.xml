    <!-- settings -->
    <string name="settings_dns_title">Upstream DNS</string>
    <string name="settings_dns_desc">Where allowed lookups are forwarded. Encrypted DNS keeps your queries private from the network.</string>
    <string name="dns_system">Automatic (device DNS)</string>
    <string name="dns_cloudflare">Cloudflare 1.1.1.1</string>
    <string name="dns_google">Google 8.8.8.8</string>
