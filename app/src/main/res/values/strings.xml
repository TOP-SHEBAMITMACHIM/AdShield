    <string name="dns_custom">Custom DNS server</string>
    <string name="dns_doh_cloudflare">Cloudflare over HTTPS</string>
    <string name="dns_doh_google">Google over HTTPS</string>
    <string name="dns_doh_adguard">AdGuard over HTTPS</string>
    <string name="dns_doh_custom">Custom HTTPS endpoint</string>
    <string name="dns_custom_hint">9.9.9.10</string>
    <string name="dns_doh_url_hint">https://dns.example.com/dns-query</string>
    <string name="settings_advanced_title">Advanced blocking</string>
    <string name="settings_hijack_title">Block hardcoded DNS servers</string>
    <string name="settings_hijack_desc">Apps that ignore the system resolver and talk straight to 8.8.8.8 or 1.1.1.1 get intercepted too, so they cannot dodge your blocklists.</string>
    <string name="settings_doh_hosts_title">Block encrypted DNS providers</string>
    <string name="settings_doh_hosts_desc">Blocks known DNS over HTTPS hostnames so apps and browsers cannot switch to an unfiltered resolver behind your back.</string>
    <string name="settings_autostart_title">Start on boot</string>
    <string name="settings_autostart_desc">Re-enable protection after the device restarts.</string>
    <string name="settings_auto_update_title">Daily list updates</string>
    <string name="settings_auto_update_desc">Download enabled blocklists once a day on Wi-Fi.</string>
    <string name="settings_toast_title">Blocked-ad message</string>
    <string name="settings_toast_desc">Shows a short message whenever an ad is blocked while another app is in the foreground. At most one message every few seconds, so a burst of blocked lookups cannot flood the screen. Some devices suppress messages coming from apps that are not on screen — use the test button to check yours.</string>
    <string name="settings_toast_test">Show a test message</string>
    <string name="settings_toast_sample_domain">ads.tracker.example.com</string>
    <string name="toast_ad_blocked">Ad blocked: %1$s</string>

